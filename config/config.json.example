{
  "_comment": "FRN-WEB — BASIS-Konfiguration (OHNE KI). Streaming, PTT/Senden, Funkarchiv. Keine Transkription, keine Sprach-KI. Wer KI-Funktionen will, nimmt stattdessen config.ai.json.example. Siehe README, Abschnitt 'Zwei Betriebsarten'.",
  "tx_server": {
    "host": "0.0.0.0",
    "port": 8765
  },
  "frn": {
    "server": "host.docker.internal",
    "port": 10024,
    "tx_timeout": 180
  },
  "icecast": {
    "host": "icecast",
    "port": 8000,
    "source_password": "ICECAST_SOURCE_PW",
    "admin_password":  "ICECAST_ADMIN_PW"
  },
  "auth": {
    "_comment": "mode: local=nur tx_users.json | frn=nur FRN-Server | both=lokal zuerst, dann FRN",
    "mode": "both"
  },
  "frn_stream_account": {
    "_comment": "Zugangsdaten für die Icecast-Stream-Clients (frn_stream_runner). Leer = aus tx_rooms.json.",
    "email":           "deine@email.de",
    "password":        "DEIN_FRN_PASSWORT",
    "callsign_prefix": "WEB"
  },
  "whisper": {
    "_comment": "OHNE KI: remote_url leer UND Whisper-Container nicht starten (WITH_WHISPER nicht setzen) = keine Transkription. Das Archiv speichert dann nur Audio, keinen Text.",
    "remote_url": "",
    "model":    "medium",
    "language": "de",
    "initial_prompt": ""
  },
  "ui": {
    "title":    "FRN Webstreams",
    "subtitle": "Free Radio Network"
  }
}
